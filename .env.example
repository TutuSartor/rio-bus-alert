# ==========================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE (REPOSITÓRIO PÚBLICO)
# ==========================================
# Copie este arquivo para .env e preencha com as suas chaves privadas.

# Configuração do Supabase (PostgreSQL / Nuvem)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anonima_publica_aqui

# Endpoint da API Privada do Backend (Render / Vercel)
PRIVATE_ENGINE_API_URL=https://sua-api-privada.onrender.com

# Configurações de Notificação do Expo
EXPO_PROJECT_ID=seu_expo_project_id_aqui
